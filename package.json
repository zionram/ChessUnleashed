{
  "name": "chess",
  "private": true,
  "version": "0.2.4-beta",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable",
    "electron:debug": "npm run build && electron ."
  },
  "build": {
    "appId": "com.chess.platform",
    "productName": "Chess Unleashed",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/chessServer.js",
      "package.json",
      "!**/.git/**",
      "!**/node_modules/.cache/**",
      "!src/**",
      "!*.log",
      "!tsconfig.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    },
    "asar": false
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stockfish": "^18.0.7",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
